{
  "name": "notion-axi",
  "version": "2.2.0",
  "packageManager": "pnpm@11.8.0",
  "description": "AXI-compliant Notion CLI for agents — token-efficient TOON output, contextual suggestions, idempotent mutations",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximebrmd/notion-axi.git"
  },
  "keywords": [
    "notion",
    "cli",
    "agent",
    "axi",
    "toon",
    "llm"
  ],
  "bin": {
    "notion-axi": "./dist/bin/notion-axi.js"
  },
  "files": [
    "dist",
    "skills/notion-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:skill": "tsx scripts/build-skill.ts",
    "dev": "tsx bin/notion-axi.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm run build && pnpm run build:skill -- --check"
  },
  "license": "MIT",
  "author": "Maxime Bourmaud (maximebrmd)",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
